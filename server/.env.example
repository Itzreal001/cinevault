# AWS credentials and S3 bucket
AWS_ACCESS_KEY_ID=YOUR_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

PORT=4000

SERVER_API_KEY=YOUR_DEV_SERVER_KEY
# Secret used to sign JWTs for user auth
SERVER_JWT_SECRET=some-long-secret
# Allow unauthenticated public downloads for movies marked `downloadable` when set to 1
# ALLOW_PUBLIC_DOWNLOADS=1
# Force all movies to be treated as downloadable (ignores per-movie flag)
# FORCE_ALL_DOWNLOADS=1
# Optional DB override path
# DB_PATH=/absolute/path/to/your/db.sqlite